#!/usr/bin/env bash
set -euo pipefail
# Download the server's graph.db and replace the local dev database with it.
cd "$(dirname "$0")/.."

remote=hetzner

bundle exec rake neo4j:stop
cd db/neo4j/development/data/databases/
ssh ${remote} /home/matthewt/livelca/bin/server/pack-graph-db
scp ${remote}:~/graph_db.zip ./
cp graph_db.zip ~/Dropbox/databases/livelca/
sudo rm -rf graph.db.bak
sudo mv graph.db/ graph.db.bak
sudo unzip graph_db.zip
sudo chown matthewt:matthewt -R graph.db
cd ../../../../../
bundle exec rake neo4j:start
